# Server-side only. Use Vercel Preview or a local ignored environment file.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_ADMIN_KEY=
SUPABASE_MEDIA_ADMIN_KEY=
DATABASE_URL=
DATABASE_TLS_CA_PEM=
SCHOOL_WORKER_SECRET=
DELIVERY_WORKER_DATABASE_URL=
INVITE_WORKER_DATABASE_URL=
SCHOOL_EMAIL_PROVIDER=resend
BREVO_API_KEY=
BREVO_FROM=
BREVO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
FCM_SERVICE_ACCOUNT_B64=
INVITATION_ENVELOPE_KEY=

# Public push settings returned only to signed-in clients. Server signing credentials are configured separately.
WEB_PUSH_PUBLIC_KEY=
FCM_ANDROID_API_KEY=
FCM_ANDROID_APP_ID=
FCM_ANDROID_PROJECT_ID=
FCM_ANDROID_SENDER_ID=

# Pre-launch SMTP and queued providers must use controlled recipients.
SCHOOL_ENVIRONMENT=prelaunch
PRELAUNCH_EMAIL_ALLOWLIST=


# Public Android release metadata; bind only after verifying the signed artifact.
ANDROID_APK_URL=
ANDROID_APK_STORAGE_HOST=
ANDROID_APPLICATION_ID=
ANDROID_SIGNING_CERT_SHA256=
ANDROID_MINIMUM_VERSION_CODE=
ANDROID_RELEASE_VERSION_CODE=
ANDROID_RELEASE_VERSION_NAME=
ANDROID_RELEASE_APK_SHA256=

{
  "name": "madrasty-el-arabia",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @madrasty/web dev",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:types": "pnpm -r check:types",
    "build:web": "pnpm --filter @madrasty/web build",
    "build:android": "node scripts/build-android.mjs",
    "qa:contracts": "tsx --env-file-if-exists=qa/.env.local --test --test-concurrency=1 qa/contracts/*.test.ts",
    "qa:school": "tsx --env-file-if-exists=qa/.env.local --test --test-concurrency=1 qa/school/*.test.ts",
    "qa:policy": "tsx --env-file-if-exists=qa/.env.local --test qa/policy/*.test.ts",
    "qa:academics": "tsx --env-file-if-exists=qa/.env.local --test --test-concurrency=1 qa/academics/*.test.ts",
    "qa:android": "tsx --test qa/android/*.test.ts && pwsh -NoProfile -File qa/android/toolchain.ps1",
    "qa:web": "playwright test --config qa/playwright.config.ts",
    "qa:communication": "tsx --env-file-if-exists=qa/.env.local --test --test-concurrency=1 qa/communication/*.test.ts",
    "qa:finance": "tsx --env-file-if-exists=qa/.env.local --test qa/finance/*.test.ts",
    "qa:ops": "tsx --env-file-if-exists=qa/.env.local --test qa/ops/dispatch.test.ts && pwsh -NoProfile -File qa/ops/restore.ps1",
    "qa:restore-media": "tsx --env-file-if-exists=qa/.env.local --env-file-if-exists=qa/.env.restore --test qa/ops/media-restore.test.ts",
    "qa:recovery-email": "tsx --env-file-if-exists=qa/.env.local --test qa/ops/recovery-email.test.ts",
    "qa:rollback": "tsx --env-file-if-exists=qa/.env.local --test qa/ops/rollback.test.ts",
    "qa:all": "pwsh -NoProfile -File qa/run-all.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "fflate": "0.8.2",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
